# =============================================================================
# MindCare Unified Digital Therapy System - Environment Configuration Template
# =============================================================================
# This file lists all environment variables used by backend and frontend services.
# Copy appropriate sections to backend/.env and emotion-stress-frontend/.env.local.
# Never commit real API keys or sensitive credentials to source control.

# -----------------------------------------------------------------------------
# 1. Backend Service Configuration (Python / FastAPI)
# -----------------------------------------------------------------------------

# Google Gemini API Key (Required for 5-stage CBT Bot & Multimodal STT)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication & RBAC Security Settings
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Administrative Provisioning Secret Keys
ADMIN_SECRET_KEY=your_admin_secret_key_here
SUPER_ADMIN_SECRET_KEY=your_super_admin_secret_key_here

# Google OAuth2 Client ID (Optional: For Google Social Login)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# -----------------------------------------------------------------------------
# 2. Frontend Application Configuration (Next.js / React 19)
# -----------------------------------------------------------------------------

# Backend REST API endpoint (defaults to http://localhost:8000/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Backend Real-time WebSocket endpoint (defaults to ws://localhost:8000/ws/therapy)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/therapy

# Google OAuth2 Client ID for Frontend Login Button (Optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
